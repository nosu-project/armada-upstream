<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>buzz.armada.app</id>
  <name>Armada</name>
  <summary>Sovereign encrypted communities and chat</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>

  <developer id="pub.soapbox">
    <name>Soapbox</name>
  </developer>

  <description>
    <p>
      Armada is a standalone Nostr client for serverless, end-to-end encrypted
      Concord communities, direct messages, channels, and voice.
    </p>
    <p>
      Communities need no host: membership, channels, moderation and voice all
      ride the Nostr relays you already use, and everything is encrypted
      end-to-end. Armada also connects to relay-hosted NIP-29 servers for
      operators who self-host.
    </p>
    <p>Features:</p>
    <ul>
      <li>Serverless, end-to-end encrypted Concord communities</li>
      <li>Direct messages and group chat</li>
      <li>Text channels with threads and rich formatting</li>
      <li>Voice and video calls with screen sharing</li>
      <li>No account, phone number or email — your Nostr key is your identity</li>
    </ul>
  </description>

  <launchable type="desktop-id">buzz.armada.app.desktop</launchable>

  <url type="homepage">https://armada.buzz</url>
  <url type="bugtracker">https://gitworkshop.dev/soapbox.pub/armada</url>
  <url type="vcs-browser">https://gitworkshop.dev/soapbox.pub/armada</url>
  <url type="contact">https://soapbox.pub</url>

  <branding>
    <color type="primary" scheme_preference="light">#c9b6ef</color>
    <color type="primary" scheme_preference="dark">#100b15</color>
  </branding>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>

