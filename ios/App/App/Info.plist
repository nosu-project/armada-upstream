<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Armada</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Armada bundles its own E2EE — ChaCha20 authenticated with HMAC-SHA256
	     (NIP-44 v2, NOT ChaCha20-Poly1305), HKDF-SHA256, and secp256k1, all
	     via @noble/* — rather than using only the OS crypto, so it does not
	     qualify for the "OS encryption only" Category 5 Part 2 exemption. The
	     AES-256-GCM that encrypts Concord attachments is by contrast the OS's
	     own, reached through WebCrypto. Standard published algorithms
	     throughout; nothing proprietary.

	     Export posture is the PUBLISHED SOURCE route, not self-classification.
	     Armada's full source is publicly available, which makes the
	     corresponding object code not subject to the EAR (15 CFR 734.3(b)(3),
	     on the strength of the 742.15(b) notification of the source URL to BIS
	     and NSA ENC). That notification is ONE-TIME: no ERN, and no annual
	     self-classification report — which the 5D992.c / 740.17(b)(1) route
	     this file used to claim would have obliged every February 1. The one
	     standing duty is to re-notify if the canonical repo URL moves.

	     Left true rather than false because the binary really does carry
	     non-OS crypto, and declaring it here stops App Store Connect asking
	     per build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Surface the app's Documents directory (where saved images/files land via
	     @capacitor/filesystem) as the "Armada" folder in the Files app, and let
	     the user manage those files in place. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Voice/video rooms (LiveKit via getUserMedia) and voice messages. Also
	     covers the WebView file input's "Take Photo or Video" option. -->
	<key>NSCameraUsageDescription</key>
	<string>Armada uses the camera for video calls and to attach photos you take to messages.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Armada uses the microphone for voice rooms, calls, and voice messages.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
