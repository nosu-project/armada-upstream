# Copy to .env and fill in. Generate secrets with:
#   RELAY_PRIVKEY:      openssl rand -hex 32
#   LIVEKIT_API_SECRET: openssl rand -hex 32

# ── Relay ─────────────────────────────────────────────────────────────────────
# The relay's own Nostr secret key (hex). It signs group metadata (39000-39004)
# and admits members. KEEP THIS SECRET; rotating it orphans existing groups.
RELAY_PRIVKEY=

RELAY_NAME=Armada Relay
RELAY_DESCRIPTION=Internal NIP-29 group relay
# Hostname (and port) clients use to reach the relay websocket.
RELAY_DOMAIN=localhost:5577
# HTTP origin of the relay as seen by browsers — used to validate NIP-98
# Authorization events on the LiveKit token endpoint. Must match exactly.
RELAY_PUBLIC_BASE_URL=http://localhost:5577

# ── Notifications (Web Push) ──────────────────────────────────────────────────
# The relay delivers push notifications for messages/mentions/replies/reactions
# and DMs directly to subscribed browsers (no external push service). VAPID keys
# authenticate those pushes; leave both EMPTY to auto-generate and persist a
# keypair in the relay's database on first run. Pin them (generate once, e.g.
# with a web-push CLI) to keep the public key stable across database wipes —
# rotating the public key invalidates every browser's existing subscription.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# Optional operator contact (email or URL) sent to push services in the VAPID
# JWT; falls back to RELAY_PUBLIC_BASE_URL when unset.
# RELAY_CONTACT=

# ── Community ─────────────────────────────────────────────────────────────────
# This relay hosts exactly ONE NIP-29 group (community), provisioned on startup.
# GROUP_ID identifies it; GROUP_NAME is its display name. Changing GROUP_ID after
# first run provisions a NEW empty group, so set it once.
GROUP_ID=armada
GROUP_NAME=Armada
# Comma-separated admin pubkeys (npub or 64-char hex). These are seeded as group
# admins on every startup (add-only: existing/runtime-added admins are never
# demoted, and removing one here does NOT strip its role — do that in-app).
ADMIN_PUBKEY=

# ── LiveKit ───────────────────────────────────────────────────────────────────
# API key + secret shared between the relay (which mints LiveKit JWTs) and the
# LiveKit SFU (which verifies them). Anyone holding both can mint a token for
# ANY room, bypassing every relay-side authorization check — so the secret must
# be high-entropy and kept secret. start.sh generates both on first run; if you
# set them by hand use `openssl rand -hex 32` for the secret.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit websocket URL as reachable from browsers. For a single-domain reverse
# proxy, set this to wss://<domain> (the LiveKit JS SDK appends its own /rtc;
# the relay normalizes a trailing /rtc away). Default localhost works as-is.
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# ── LiveKit media / WebRTC (advanced; see AGENTS.md "Voice / LiveKit") ─────────
# How clients reach media. By default LiveKit STUN-discovers its public IP.
# In a cloud host where the public IP isn't on the interface, leave
# USE_EXTERNAL_IP=true. Behind a reverse proxy / split network, set
# USE_EXTERNAL_IP=false and NODE_IP to the address clients send media to
# (typically the SFU host's LAN IP — LAN clients then connect directly).
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_NODE_IP=
# Network interface the SFU gathers ICE candidates on (inside the container).
LIVEKIT_IFACE=eth0

# Embedded TURN/TLS relay. Enable for production so clients on networks that
# block/mangle UDP (mobile, CGNAT, corporate firewalls) relay media over
# TLS/443. Requires: (1) a real TLS cert for TURN_DOMAIN mounted at CERT_DIR as
# tls.crt/tls.key, and (2) the edge to deliver turn.<domain>:443 to this SFU
# (e.g. nginx ssl_preread SNI passthrough). See AGENTS.md for the full recipe.
LIVEKIT_TURN_ENABLED=false
LIVEKIT_TURN_DOMAIN=turn.localhost
# Host dir containing tls.crt + tls.key for the TURN domain.
LIVEKIT_CERT_DIR=./certs/turn
# Host port mapped to the SFU's TURN/TLS :443. Use 443 when the edge forwards
# turn.<domain>:443 here; otherwise a high port (e.g. 5349) to avoid clashing.
LIVEKIT_TURN_PORT=5349

# ── Client ────────────────────────────────────────────────────────────────────
APP_NAME=Armada
# Host port the web client is served on.
CLIENT_PORT=8080
# Comma-separated pinned relay URLs baked into the client build.
PLATFORM_RELAYS=ws://localhost:5577
# Default app relays for non-NIP-29 traffic (profiles, lists). Users can edit
# these in Settings; set to an internal relay (or your platform relay) for a
# fully air-gapped deployment.
APP_RELAYS=wss://relay.ditto.pub,wss://relay.dreamith.to

# Default mic audio-processing toggles for voice calls (true/false). These seed
# each user's in-call audio settings; users can override them per device. All
# default to true (LiveKit/browser defaults) for good noise/echo handling.
# DEFAULT_NOISE_SUPPRESSION=true
# DEFAULT_ECHO_CANCELLATION=true
# DEFAULT_AUTO_GAIN_CONTROL=true
